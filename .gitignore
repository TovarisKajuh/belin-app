.superpowers/

# The founder's raw screenshot captures. The processed, web-sized versions
# that the landing page actually serves live in public/landing/.
screenshots/

# Intermediate cutout masters. Derived from assets/marketing/source/ by
# `npm run marketing:cutout` in about two seconds, and 8 MB of PNG that nothing
# reads except the WebP step is not worth carrying in the history forever. The
# source exports ARE committed: those exist nowhere else.
assets/marketing/hero/

# Throwaway verification scripts and screenshots for the current session.
.tmp-qa/

# Raw video takes and the ffmpeg work directory. Both regenerate from
# `npm run marketing:video`; the finished mp4s beside them ARE committed.
assets/marketing/video/takes/
assets/marketing/video/.work/

# Rasterized brochure pages, for looking at during a build. The PDF itself is
# committed; these regenerate from `npm run marketing:brochure`.
assets/marketing/brochure-pages/
