# Copy to .env.local and fill in. Values come from Task 2 (guided).
# NEVER commit .env.local. The service role key bypasses all row security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The one real address in the demo seed. Every other seeded address is on a
# *-demo.si domain, which is fake and never receives mail. Set this to your own
# address to receive real magic-link and notification emails while testing.
SEED_FOUNDER_EMAIL=
