{
  "name": "belin-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file=.env.local scripts/seed-demo.mjs && npm run seed:documents",
    "gen:types": "node scripts/gen-types.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "k2:try": "tsx scripts/k2-try.ts",
    "seed:documents": "tsx --tsconfig tsconfig.scripts.json --env-file=.env.local scripts/seed-documents.ts",
    "marketing:shoot": "node scripts/marketing/shoot.mjs",
    "marketing:flow": "node scripts/marketing/run-demo-flow.mjs",
    "marketing:pdfs": "node scripts/marketing/pdf-shots.mjs",
    "marketing:all": "npm run seed && npm run marketing:shoot && npm run marketing:flow && npm run marketing:pdfs && npm run marketing:mockups && npm run marketing:og && npm run seed",
    "marketing:mockups": "node scripts/marketing/mockups.mjs",
    "marketing:cutout": "node scripts/marketing/cutout.mjs",
    "marketing:og": "node scripts/marketing/og.mjs",
    "marketing:video:takes": "node scripts/marketing/video-takes.mjs",
    "marketing:video:cut": "node scripts/marketing/video-cut.mjs",
    "marketing:video": "npm run marketing:video:takes && npm run marketing:video:cut",
    "marketing:brochure": "tsx --tsconfig tsconfig.scripts.json scripts/marketing/brochure.mjs",
    "marketing:germanize": "node --env-file=.env.local scripts/marketing/germanize.mjs",
    "marketing:pipeline": "node scripts/marketing/pipeline.mjs",
    "marketing:sl": "node scripts/marketing/pipeline.mjs sl",
    "marketing:de": "node scripts/marketing/pipeline.mjs de"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.6",
    "next-intl": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@react-pdf/types": "^2.11.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "sharp": "^0.34.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
